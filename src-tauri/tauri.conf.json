{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jieqibox",
  "version": "0.6.6",
  "identifier": "com.jieqibox.app",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
  {
    "title": "JieqiBox AI",
    "width": 400,
    "height": 700,
    "alwaysOnTop": true,
    "resizable": true,
    "decorations": true,
    "transparent": false
  }
],
    "security": { "csp": null }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
